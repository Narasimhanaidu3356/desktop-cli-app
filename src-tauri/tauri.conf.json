{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TalentScreen Apply",
  "version": "0.1.1",
  "identifier": "com.whiteboxlearning.talentscreen",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TalentScreen Apply",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../automation-sidecar/bin/talentscreen-automation.exe",
      "../automation-sidecar/browsers/**/*",
      "../../project-talentscreen-autofill-extension/**/*"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}