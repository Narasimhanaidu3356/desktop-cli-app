{
  "manifest_version": 3,
  "name": "TalentScreen Autofill",
  "version": "0.1.2",
  "description": "Deterministic Greenhouse and Lever application autofill for TalentScreen desktop app.",
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "http://localhost:8000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.greenhouse.io/*", "https://*.lever.co/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
